# Modèle de configuration : copier vers .env (jamais commité). Aucun secret réel ici.
# Après une modification du .env : `wsl docker compose up -d` (recrée le conteneur avec les nouvelles valeurs).

# --- PostgreSQL ---
POSTGRES_USER=soc
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=soc_incidents
POSTGRES_PORT=5432

# --- Backend ---
APPLICATION_ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Escalade automatique des incidents en retard : intervalle en secondes (0 = désactivée, déclenchement manuel seulement).
AUTOMATIC_ESCALATION_INTERVAL_SECONDS=300
# Compte du conteneur backend. Laisser vide (compte non-root). Mettre root UNIQUEMENT si le projet est dans un
# dossier partagé VirtualBox (/media/sf_...) et que le démarrage signale des fichiers illisibles.
BACKEND_CONTAINER_USER=

# =====================================================================================================================
# SOURCE DES ALERTES
#   true  : mode DÉMONSTRATION, alertes inventées ; aucun port syslog ouvert (les valeurs SYSLOG_* sont ignorées).
#   false : alertes RÉELLES, transférées par FortiAnalyzer en syslog vers le port décrit plus bas.
# =====================================================================================================================
APP_IS_IN_DEMO=true

# --- Collecte des alertes ---
# Toutes les N secondes, les logs reçus par syslog sont enregistrés en base (0 = désactivée ; bouton « Lancer une
# collecte » dans la page Journaux). En mode réel, garder une valeur courte : les logs en attente sont en mémoire.
LOG_COLLECTION_INTERVAL_SECONDS=30
# Sévérité minimale enregistrée : information, faible, moyenne, haute, critique.
LOG_COLLECTION_MINIMUM_CRITICALITY=haute

# --- Réception syslog (utilisée seulement si APP_IS_IN_DEMO=false) ---
# Dans FortiAnalyzer : System Settings > Advanced > Log Forwarding, serveur = adresse du poste, port = SYSLOG_LISTEN_PORT.
SYSLOG_LISTEN_ADDRESS=0.0.0.0
# 5140 : pas besoin de droits administrateur (514, le port standard, en demande). Publié par docker-compose.yml.
SYSLOG_LISTEN_PORT=5140
SYSLOG_IS_UDP_ENABLED=true
SYSLOG_IS_TCP_ENABLED=true
# Adresses IP autorisées à envoyer des logs, séparées par des virgules (vide = toutes). Recommandé : l'adresse de
# FortiAnalyzer, vue depuis l'application (le syslog n'est pas authentifié).
SYSLOG_ALLOWED_SENDER_ADDRESSES=
# Logs en attente de collecte au maximum (au-delà, ils sont perdus et comptés dans la page Journaux).
SYSLOG_MAXIMUM_PENDING_LOGS=100000
# Fuseau des champs date/time d'un log sans eventtime ni tz (rare). Ex. : Europe/Paris, Africa/Douala, UTC.
FORTIANALYZER_TIMEZONE=UTC

# --- Tests d'intégration PostgreSQL (facultatif) ---
# Base DÉDIÉE aux tests, vidée par les tests ; son nom doit contenir « test ». Voir docs/technical/testing.md.
# TEST_POSTGRESQL_DATABASE_URL=postgresql+psycopg://soc:change_me_locally@localhost:5432/soc_incidents_test
