# Modèle de configuration : copier vers .env (jamais commité). Aucun secret réel ici.
# Après une modification du .env : `wsl docker compose up -d` (recrée le conteneur avec les nouvelles valeurs).

# --- PostgreSQL ---
POSTGRES_USER=soc
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=soc_incidents
POSTGRES_PORT=5432

# --- Backend ---
APPLICATION_ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Escalade automatique des incidents en retard : intervalle en secondes (0 = désactivée, déclenchement manuel seulement).
AUTOMATIC_ESCALATION_INTERVAL_SECONDS=300
# Compte du conteneur backend. Laisser vide (compte non-root). Mettre root UNIQUEMENT si le projet est dans un
# dossier partagé VirtualBox (/media/sf_...) et que le démarrage signale des fichiers illisibles.
BACKEND_CONTAINER_USER=

# =====================================================================================================================
# SOURCE DES ALERTES
#   true  : mode DÉMONSTRATION, alertes inventées ; aucune connexion à FortiAnalyzer (les valeurs plus bas sont ignorées).
#   false : alertes RÉELLES lues sur le FortiAnalyzer décrit plus bas.
# =====================================================================================================================
APP_IS_IN_DEMO=true

# --- Collecte des alertes ---
# Collecte automatique toutes les N secondes (0 = désactivée ; bouton « Lancer une collecte » dans la page Journaux).
LOG_COLLECTION_INTERVAL_SECONDS=300
# Toute première collecte : nombre d'heures d'historique à récupérer.
LOG_COLLECTION_INITIAL_LOOKBACK_HOURS=24
# Sévérité minimale enregistrée : information, faible, moyenne, haute, critique.
LOG_COLLECTION_MINIMUM_CRITICALITY=haute

# --- Connexion FortiAnalyzer (utilisée seulement si APP_IS_IN_DEMO=false) ---
# Adresse complète, avec https:// et le port s'il n'est pas 443. Ex. : https://192.168.1.50 ou https://faz.entreprise.local:8443
FORTIANALYZER_BASE_URL=
# Authentification, AU CHOIX :
#   1) jeton API (FortiAnalyzer 7.2.2 et plus, recommandé) : remplir FORTIANALYZER_API_TOKEN, laisser les deux suivants vides ;
#   2) compte administrateur API : remplir FORTIANALYZER_USERNAME et FORTIANALYZER_PASSWORD.
# Utiliser un compte en LECTURE SEULE sur les logs : l'application ne fait que lire.
FORTIANALYZER_API_TOKEN=
FORTIANALYZER_USERNAME=
FORTIANALYZER_PASSWORD=
# ADOM (domaine administratif) à interroger ; « root » si les ADOM ne sont pas activés.
FORTIANALYZER_ADOM=root
# Vérification du certificat HTTPS. Avec un certificat auto-signé : indiquer le fichier de l'autorité (CA) dans
# FORTIANALYZER_CA_BUNDLE_PATH (chemin DANS le conteneur, ex. /application/certificates/faz_ca.pem) plutôt que false.
FORTIANALYZER_VERIFY_TLS=true
FORTIANALYZER_CA_BUNDLE_PATH=
# Types de logs interrogés, séparés par des virgules : event (système), attack (IPS), virus, webfilter, traffic...
FORTIANALYZER_LOG_TYPES=event,attack
# Équipements interrogés (All_FortiGate = tous les FortiGate de l'ADOM).
FORTIANALYZER_DEVICE_IDENTIFIER=All_FortiGate
# Filtre facultatif dans la syntaxe de recherche FortiAnalyzer (laisser vide : l'application filtre par sévérité).
FORTIANALYZER_SEARCH_FILTER=
# Fuseau horaire de FortiAnalyzer (pour les bornes de recherche). Ex. : Europe/Paris, Africa/Douala, UTC.
FORTIANALYZER_TIMEZONE=UTC
FORTIANALYZER_REQUEST_TIMEOUT_SECONDS=30

# --- Tests d'intégration PostgreSQL (facultatif) ---
# Base DÉDIÉE aux tests, vidée par les tests ; son nom doit contenir « test ». Voir docs/technical/testing.md.
# TEST_POSTGRESQL_DATABASE_URL=postgresql+psycopg://soc:change_me_locally@localhost:5432/soc_incidents_test
